
#include <WiFi.h>
#include <HTTPClient.h>

// Dades de la xarxa Wi-Fi virtual de Wokwi
const char* ssid = "Wokwi-GUEST";
const char* password = "";

// API per consultar la data i hora de Madrid
const char* url = "http://worldtime.timezone.io/api/timezone/Europe/Madrid";

void connectarWiFi() {
  Serial.println("Connectant al Wi-Fi...");

  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, password, 6);

  int intents = 0;

  while (WiFi.status() != WL_CONNECTED && intents < 40) {
    delay(500);
    Serial.print(".");
    intents++;
  }

  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("\nWi-Fi connectat correctament!");
    Serial.print("Adreca IP: ");
    Serial.println(WiFi.localIP());

    Serial.print("Senyal Wi-Fi: ");
    Serial.print(WiFi.RSSI());
    Serial.println(" dBm");
  } else {
    Serial.println("\nError: no s'ha pogut connectar al Wi-Fi.");
  }
}

void consultarHora() {
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("Wi-Fi desconnectat. Reconnectant...");
    connectarWiFi();
  }

  if (WiFi.status() == WL_CONNECTED) {
    HTTPClient http;

    Serial.println("\nEnviant peticio HTTP GET...");

    http.begin(url);
    http.setTimeout(10000);

    int codiResposta = http.GET();

    if (codiResposta > 0) {
      Serial.print("Codi de resposta HTTP: ");
      Serial.println(codiResposta);

      if (codiResposta == HTTP_CODE_OK) {
        String resposta = http.getString();

        Serial.println("Resposta del servidor:");
        Serial.println(resposta);
      } else {
        Serial.println("El servidor ha retornat un error HTTP.");
        Serial.println(http.getString());
      }
    } else {
      Serial.print("Error en la peticio HTTP: ");
      Serial.println(http.errorToString(codiResposta));
    }

    http.end();
  }
}

void setup() {
  Serial.begin(115200);
  delay(1000);

  Serial.println("\n--- PROJECTE A09: CONNECTIVITAT ESP32 ---");

  connectarWiFi();
}

void loop() {
  consultarHora();

  Serial.println("\nEsperant 30 segons per a la seguent consulta...");
  delay(30000);
}
