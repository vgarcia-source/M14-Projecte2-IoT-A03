#include <WiFi.h>
#include <HTTPClient.h>
#include <Wire.h>
#include <LiquidCrystal_I2C.h>

// LCD I2C
LiquidCrystal_I2C lcd(0x27, 16, 2);

// WiFi
const char* ssid = "Wokwi-GUEST";
const char* password = "";

// URL
const char* url = "http://worldtime.timezone.io/api/timezone/Europe/Madrid";

void connectarWiFi() {

  Serial.println("Connectant al WiFi...");

  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Connectant...");
  lcd.setCursor(0, 1);
  lcd.print("WiFi");

  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, password, 6);

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println("\nWiFi connectat!");

  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("WiFi Connectat");
  lcd.setCursor(0, 1);
  lcd.print("OK");

  delay(2000);
}

void consultarHora() {

  HTTPClient http;

  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Consultant");
  lcd.setCursor(0, 1);
  lcd.print("Servidor...");

  http.begin(url);

  int codiResposta = http.GET();

  if (codiResposta > 0) {

    Serial.print("HTTP: ");
    Serial.println(codiResposta);

    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("Resposta HTTP");
    lcd.setCursor(0, 1);
    lcd.print(codiResposta);

  } else {

    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("Error HTTP");
  }

  http.end();
}

void setup() {

  Serial.begin(115200);

  lcd.init();
  lcd.backlight();

  lcd.setCursor(0, 0);
  lcd.print("PROJECTE A013");
  lcd.setCursor(0, 1);
  lcd.print("ESP32 + LCD");

  delay(3000);

  connectarWiFi();
}

void loop() {

  consultarHora();

  delay(5000);

  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("IP ESP32:");

  lcd.setCursor(0, 1);
  lcd.print(WiFi.localIP());

  delay(5000);
}
